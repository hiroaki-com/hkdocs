# Git
.git
.gitignore

# Node.js
node_modules

# Docusaurus build output and cache
build
.docusaurus

# Docker related files (prevent from being sent to Docker daemon)
Dockerfile
Dockerfile.dev
docker-compose.yml
docker-compose.*.yml

# Deployment scripts & environment specific files
deploy.sh
.env
.env.*
*.local

# Credentials that CI may materialize in the workspace.
# google-github-actions/auth writes gha-creds-*.json before the image is built,
# so without these entries `COPY . .` would bake it into a GHA-cached layer.
gha-creds-*.json
*.pem
*.p12
*.pfx
service-account*.json

# Local-only agent docs (excluded from the repository via .git/info/exclude)
.claude/

# Logs
*.log
pnpm-debug.log*

# IDE/Editor specific
.DS_Store
.vscode/
.idea/

# Other project specific files not needed in build context
# .nvmrc # Already ignored by default if not copied in Dockerfile
